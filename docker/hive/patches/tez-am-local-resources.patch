+  private LocalResource localizeAmSecret(String source, String name, Path amSecretsDir)
+      throws IOException {
+    if (source == null || source.isEmpty()) {
+      throw new IOException("Missing source path for Tez AM secret " + name);
+    }
+    // Use a new remote name on each open so a rotated secret cannot reuse an
+    // existing YARN LocalResource with the same size and modification time.
+    Path dest = new Path(amSecretsDir, UUID.randomUUID().toString() + "-" + name);
+    LocalResource resource = utils.localizeResource(
+        new Path(source), dest, LocalResourceType.FILE, conf);
+    dest.getFileSystem(conf).setPermission(dest, new FsPermission((short) 0400));
+    return resource;
+  }
