<configuration>
  <property>
    <name>dfs.nameservices</name>
    <value>zookage</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.zookage.namenode-0</name>
    <value>hdfs-namenode-0.hdfs-namenode.zookage.svc.cluster.local:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.zookage.namenode-0</name>
    <value>hdfs-namenode-0.hdfs-namenode.zookage.svc.cluster.local:9870</value>
  </property>
  <property>
    <name>dfs.namenode.https-address.zookage.namenode-0</name>
    <value>hdfs-namenode-0.hdfs-namenode.zookage.svc.cluster.local:9871</value>
  </property>
  <property>
    <name>dfs.namenode.https-address.zookage.namenode-1</name>
    <value>hdfs-namenode-1.hdfs-namenode.zookage.svc.cluster.local:9871</value>
  </property>
  <property>
    <name>dfs.client.failover.proxy.provider.zookage</name>
    <value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value>
  </property>

  <property>
    <name>hadoop.http.authentication.signer.secret.provider</name>
    <value>random</value>
  </property>

  <property>
    <name>dfs.namenode.kerberos.principal</name>
    <value>hdfs/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>dfs.namenode.keytab.file</name>
    <value>/etc/hadoop/secrets/hdfs.keytab</value>
  </property>
  <property>
    <name>dfs.datanode.kerberos.principal</name>
    <value>hdfs/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>dfs.datanode.keytab.file</name>
    <value>/etc/hadoop/secrets/hdfs.keytab</value>
  </property>
  <property>
    <name>dfs.journalnode.kerberos.principal</name>
    <value>hdfs/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>dfs.journalnode.keytab.file</name>
    <value>/etc/hadoop/secrets/hdfs.keytab</value>
  </property>
  <property>
    <name>dfs.web.authentication.kerberos.principal</name>
    <value>HTTP/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>dfs.web.authentication.kerberos.keytab</name>
    <value>/etc/hadoop/secrets/hdfs.keytab</value>
  </property>
  <property>
    <name>dfs.namenode.kerberos.internal.spnego.principal</name>
    <value>${dfs.web.authentication.kerberos.principal}</value>
  </property>
  <property>
    <name>dfs.journalnode.kerberos.internal.spnego.principal</name>
    <value>${dfs.web.authentication.kerberos.principal}</value>
  </property>
  <property>
    <name>dfs.block.access.token.enable</name>
    <value>{{ or (index .Values "hadoop_dfs_block_access_token_enable") "false" | html }}</value>
  </property>
  <property>
    <name>dfs.data.transfer.protection</name>
    <value>{{ or (index .Values "hadoop_dfs_data_transfer_protection") "" | html }}</value>
  </property>
  <property>
    <name>dfs.http.policy</name>
    <value>{{ or (index .Values "hadoop_dfs_http_policy") "HTTP_ONLY" | html }}</value>
  </property>

  <property>
    <name>dfs.ha.namenodes.zookage</name>
    <value>{{ or (index .Values "hadoop_dfs_ha_namenodes") "namenode-0" | html }}</value>
  </property>
  <property>
    <name>dfs.ha.automatic-failover.enabled</name>
    <value>{{ or (index .Values "hadoop_dfs_ha_automatic_failover_enabled") "false" | html }}</value>
  </property>
  <property>
    <name>dfs.ha.fencing.methods</name>
    <value>{{ or (index .Values "hadoop_dfs_ha_fencing_methods") "" | html }}</value>
  </property>
  <property>
    <name>dfs.namenode.shared.edits.dir</name>
    <value>{{ or (index .Values "hadoop_dfs_namenode_shared_edits_dir") "" | html }}</value>
  </property>
  <property>
    <name>dfs.journalnode.edits.dir</name>
    <value>${hadoop.tmp.dir}/dfs/journal</value>
  </property>
  <property>
    <name>dfs.namenode.rpc-address.zookage.namenode-1</name>
    <value>hdfs-namenode-1.hdfs-namenode.zookage.svc.cluster.local:8020</value>
  </property>
  <property>
    <name>dfs.namenode.http-address.zookage.namenode-1</name>
    <value>hdfs-namenode-1.hdfs-namenode.zookage.svc.cluster.local:9870</value>
  </property>

  <property>
    <name>dfs.namenode.rpc-bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file://${hadoop.tmp.dir}/dfs/nn1,file://${hadoop.tmp.dir}/dfs/nn2</value>
  </property>
  <property>
    <name>dfs.namenode.acls.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.namenode.datanode.registration.ip-hostname-check</name>
    <value>false</value>
  </property>

  <property>
    <name>dfs.permissions.ContentSummary.subAccess</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.namenode.inode.attributes.provider.class</name>
    <value>{{ or (index .Values "hadoop_dfs_namenode_inode_attributes_provider_class") "org.apache.hadoop.hdfs.server.namenode.DefaultINodeAttributesProvider" | html }}</value>
  </property>

  <property>
    <name>dfs.datanode.data.dir</name>
    <value>[DISK]file://${hadoop.tmp.dir}/dfs/dn</value>
  </property>
  <property>
    <!-- HDFS-16347 -->
    <name>dfs.datanode.directoryscan.throttle.limit.ms.per.sec</name>
    <value>500</value>
  </property>

  <property>
    <name>dfs.webhdfs.rest-csrf.enabled</name>
    <value>true</value>
  </property>
</configuration>
