{
  "type": "hbase",
  "name": "hbase",
  "configs": {
    "username": "hbase",
    "password": "dummy",
    "hadoop.security.authentication": "{{ if eq (index .Values "hadoop_security_authentication") "kerberos" }}kerberos{{ else }}simple{{ end }}",
    "hbase.security.authentication": "{{ if eq (index .Values "hbase_security_authentication") "kerberos" }}kerberos{{ else }}simple{{ end }}",
    "hbase.master.kerberos.principal": "hbase/_HOST@ZOOKAGE.LOCAL",
    "policy.download.auth.users": "hbase",
    "tag.download.auth.users": "hbase",
    "hbase.zookeeper.property.clientPort": "2181",
    "hbase.zookeeper.quorum": "zookeeper-server-0.zookeeper-server.zookage.svc.cluster.local,zookeeper-server-1.zookeeper-server.zookage.svc.cluster.local,zookeeper-server-2.zookeeper-server.zookage.svc.cluster.local",
    "zookeeper.znode.parent": "/hbase"
  }
}
