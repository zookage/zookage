<configuration>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>yarn-resourcemanager-0.yarn-resourcemanager.zookage.svc.cluster.local</value>
  </property>
  <property>
    <name>yarn.resourcemanager.ha.enabled</name>
    <value>{{ or (index .Values "hadoop_yarn_resourcemanager_ha_enabled") "false" | html }}</value>
  </property>
  <property>
    <name>yarn.resourcemanager.ha.rm-ids</name>
    <value>{{ or (index .Values "hadoop_yarn_resourcemanager_ha_rm_ids") "resourcemanager-0" | html }}</value>
  </property>
  <property>
    <name>yarn.resourcemanager.hostname.resourcemanager-0</name>
    <value>yarn-resourcemanager-0.yarn-resourcemanager.zookage.svc.cluster.local</value>
  </property>
  <property>
    <name>yarn.resourcemanager.hostname.resourcemanager-1</name>
    <value>yarn-resourcemanager-1.yarn-resourcemanager.zookage.svc.cluster.local</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.address.resourcemanager-0</name>
    <value>yarn-resourcemanager-0.yarn-resourcemanager.zookage.svc.cluster.local:8088</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.address.resourcemanager-1</name>
    <value>yarn-resourcemanager-1.yarn-resourcemanager.zookage.svc.cluster.local:8088</value>
  </property>

  <property>
    <name>hadoop.http.authentication.signer.secret.provider</name>
    <value>random</value>
  </property>

  <property>
    <name>yarn.acl.enable</name>
    <value>{{ or (index .Values "hadoop_yarn_acl_enable") "false" | html }}</value>
  </property>
  <property>
    <name>yarn.authorization-provider</name>
    <value>{{ or (index .Values "hadoop_yarn_authorization_provider") "org.apache.hadoop.yarn.security.ConfiguredYarnAuthorizer" | html }}</value>
  </property>

  <property>
    <name>yarn.resourcemanager.cluster-id</name>
    <value>zookage</value>
  </property>
  <property>
    <name>yarn.resourcemanager.principal</name>
    <value>yarn/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>yarn.resourcemanager.keytab</name>
    <value>/etc/secrets/yarn/yarn.keytab</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.spnego-principal</name>
    <value>HTTP/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.spnego-keytab-file</name>
    <value>${yarn.resourcemanager.keytab}</value>
  </property>
  <property>
    <name>yarn.resourcemanager.webapp.cross-origin.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.resourcemanager.bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>yarn.resourcemanager.placement-constraints.handler</name>
    <value>scheduler</value>
  </property>
  <property>
    <name>yarn.resourcemanager.system-metrics-publisher.enabled</name>
    <value>true</value>
  </property>

  <property>
    <name>yarn.nodemanager.address</name>
    <value>${yarn.nodemanager.hostname}:8041</value>
  </property>
  <property>
    <name>yarn.nodemanager.principal</name>
    <value>yarn/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>yarn.nodemanager.keytab</name>
    <value>/etc/secrets/yarn/yarn.keytab</value>
  </property>
  <property>
    <name>yarn.nodemanager.webapp.spnego-principal</name>
    <value>HTTP/_HOST@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>yarn.nodemanager.webapp.spnego-keytab-file</name>
    <value>${yarn.nodemanager.keytab}</value>
  </property>
  <property>
    <name>yarn.nodemanager.container-executor.class</name>
    <value>{{ or (index .Values "hadoop_yarn_nodemanager_container_executor_class") "org.apache.hadoop.yarn.server.nodemanager.DefaultContainerExecutor" | html }}</value>
  </property>
  <property>
    <name>yarn.nodemanager.linux-container-executor.group</name>
    <value>hadoop</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle,tez_shuffle</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services.tez_shuffle.class</name>
    <value>org.apache.tez.auxservices.ShuffleHandler</value>
  </property>
  <property>
    <name>yarn.nodemanager.env-whitelist</name>
    <value>JAVA_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,CLASSPATH_PREPEND_DISTCACHE,HADOOP_YARN_HOME,HADOOP_HOME,HADOOP_OPTIONAL_TOOLS,PATH,LANG,TZ,HADOOP_MAPRED_HOME</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>${hadoop.tmp.dir}/userlogs</value>
  </property>
  <property>
    <name>yarn.nodemanager.remote-app-log-dir</name>
    <value>/tmp</value>
  </property>
  <property>
    <name>yarn.nodemanager.remote-app-log-dir-suffix</name>
    <value>yarn-app-logs</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>2048</value>
  </property>
  <property>
    <name>yarn.nodemanager.vmem-pmem-ratio</name>
    <value>10.0</value>
  </property>

  <property>
    <name>yarn.timeline-service.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.timeline-service.hostname</name>
    <value>yarn-timelineserver-0.yarn-timelineserver.zookage.svc.cluster.local</value>
  </property>
  <property>
    <name>yarn.timeline-service.principal</name>
    <value>yarn/yarn-timelineserver-0.yarn-timelineserver.zookage.svc.cluster.local@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>yarn.timeline-service.keytab</name>
    <value>/etc/secrets/yarn/yarn.keytab</value>
  </property>
  <property>
    <name>yarn.timeline-service.http-authentication.type</name>
    <value>{{ or (index .Values "hadoop_yarn_timeline_service_http_authentication_type") "simple" | html }}</value>
  </property>
  <property>
    <name>yarn.timeline-service.http-authentication.kerberos.principal</name>
    <value>HTTP/yarn-timelineserver-0.yarn-timelineserver.zookage.svc.cluster.local@ZOOKAGE.LOCAL</value>
  </property>
  <property>
    <name>yarn.timeline-service.http-authentication.kerberos.keytab</name>
    <value>${yarn.timeline-service.keytab}</value>
  </property>
  <property>
    <name>yarn.timeline-service.bind-host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>yarn.timeline-service.http-cross-origin.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.timeline-service.http-cross-origin.allowed-origins</name>
    <value>{{ or (index .Values "hadoop_yarn_timeline_service_http_cross_origin_allowed_origins") "*" | html }}</value>
  </property>
  <property>
    <name>yarn.timeline-service.generic-application-history.enabled</name>
    <value>true</value>
  </property>

  <property>
    <name>yarn.webapp.ui2.enable</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>128</value>
  </property>

  <property>
    <name>yarn.service.framework.path</name>
    <value>/yarn-services/service-dep.tar.gz</value>
  </property>
</configuration>
