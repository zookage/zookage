{{ if eq (index .Values "zookeeper_security_authentication") "kerberos" }}
if [[ ${ZOOKEEPER_SERVER:-} == true ]]; then
  export JAVA_TOOL_OPTIONS=--add-opens=java.base/java.lang=ALL-UNNAMED
  JMXDISABLE=true
  SERVER_JVMFLAGS='-Djava.security.auth.login.config=/mnt/zookeeper-jaas.conf -Dzookeeper.serverCnxnFactory=org.apache.zookeeper.server.NettyServerCnxnFactory'
  # zkServer.sh status connects to localhost, which is not in the server certificate SAN.
  if [[ -z ${CLIENT_JVMFLAGS+x} ]]; then
    CLIENT_JVMFLAGS='
      -Dzookeeper.client.secure=true
      -Dzookeeper.clientCnxnSocket=org.apache.zookeeper.ClientCnxnSocketNetty
      -Dzookeeper.ssl.hostnameVerification=false
      -Dzookeeper.ssl.keyStore.location=/etc/secrets/zookeeper-client/zookeeper-client.jks
      -Dzookeeper.ssl.keyStore.passwordPath=/etc/secrets/zookeeper-client/store.password
      -Dzookeeper.ssl.trustStore.location=/etc/zookeeper/conf/zookage-truststore.jks
      -Dzookeeper.ssl.trustStore.passwordPath=/etc/secrets/zookeeper-client/store.password
    '
  fi
elif [[ -z ${CLIENT_JVMFLAGS+x} ]]; then
  # Preserve explicit client settings, including intentional empty overrides.
  CLIENT_JVMFLAGS=-Djava.security.auth.login.config=/etc/zookeeper/conf/client-jaas.conf
fi
{{ end }}
