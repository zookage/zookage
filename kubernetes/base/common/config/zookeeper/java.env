{{ if eq (index .Values "zookeeper_security_authentication") "kerberos" }}
if [[ ${ZOOKEEPER_SERVER:-} == true ]]; then
  JMXDISABLE=true
  SERVER_JVMFLAGS="@${ZOOCFGDIR}/server.jvmopts -Dzookage.zookeeper.server.principal=zookeeper/${POD_NAME}.zookeeper-server.zookage.svc.cluster.local@ZOOKAGE.LOCAL"
  if [[ -z ${CLIENT_JVMFLAGS+x} ]]; then
    CLIENT_JVMFLAGS="@${ZOOCFGDIR}/status.jvmopts"
  fi
elif [[ -z ${CLIENT_JVMFLAGS+x} ]]; then
  # Preserve explicit client settings, including intentional empty overrides.
  CLIENT_JVMFLAGS="@${ZOOCFGDIR}/client.jvmopts"
fi
{{ end }}
